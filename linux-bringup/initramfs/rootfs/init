#!/bin/sh
PATH=/bin:/sbin

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

/bin/busybox mknod /dev/kmsg c 1 11 2>/dev/null
log() {
    echo "$1"
    echo "$1" > /dev/kmsg 2>/dev/null
}

log "rescue-init: SPI-SD smoke test start"
log "rescue-init: waiting for /dev/mmcblk0p1"

i=0
while [ ! -b /dev/mmcblk0p1 ] && [ "$i" -lt 30 ]; do
    sleep 1
    i=$((i + 1))
done

log "rescue-init: current block devices"
cat /proc/partitions

mkdir -p /newroot
if ! mount -t ext4 /dev/mmcblk0p1 /newroot; then
    log "rescue-init: mount /dev/mmcblk0p1 failed"
    exec /bin/sh
fi

if [ ! -x /newroot/sbin/init ]; then
    log "rescue-init: /newroot/sbin/init missing"
    exec /bin/sh
fi

log "rescue-init: switch_root to SD root"
exec switch_root /newroot /sbin/init
